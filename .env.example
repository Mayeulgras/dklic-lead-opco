# Copier ce fichier en `.env.local` (développement) ou renseigner ces variables
# dans l'hébergement (Vercel > Settings > Environment Variables), puis lancer
# `npm run verifier`. Procédure complète : Branchement_Odoo_et_Mail.md.
#
# Tant qu'Odoo ou le mail ne sont pas renseignés, `npm run dev` les simule
# (le contenu s'affiche dans le terminal). En production, un canal absent
# compte comme une panne : ne pas mettre en ligne sans eux.

# URL de la politique de confidentialité du client (page du site Odoo).
# Requise pour la conformité RGPD : tant qu'elle est absente, le libellé de
# consentement s'affiche sans lien.
NEXT_PUBLIC_PRIVACY_POLICY_URL=https://dklic-formations.odoo.com/politique-de-confidentialite

# --- Odoo (création du client et de l'opportunité CRM) ----------------------
# Adresse de l'instance, sans / final.
ODOO_URL=https://dklic-formations.odoo.com
# Clé API de l'utilisateur Odoo dédié (Préférences > Sécurité du compte >
# Nouvelle clé API). Elle expire au plus tard au bout de 3 MOIS : la renouveler
# avant, sinon seul le mail continuera de fonctionner.
ODOO_API_KEY=
# Facultatif : nom de la base, seulement si le serveur Odoo en héberge plusieurs.
ODOO_DB=
# Facultatif : identifiant de l'utilisateur Odoo (commercial) à qui attribuer
# les opportunités et les rappels. `npm run verifier` liste les identifiants.
ODOO_COMMERCIAL_ID=

# --- Mail de notification à l'équipe (SMTP) ---------------------------------
# Serveur d'envoi de la messagerie utilisée (Google, Microsoft, OVH, Brevo…).
SMTP_HOST=
# 587 (le plus courant) ou 465.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Facultatif : adresse affichée comme expéditeur, par défaut SMTP_USER. Doit
# être autorisée par le serveur SMTP, sinon le mail part en spam ou est refusé.
MAIL_EXPEDITEUR=
# L'adresse qui reçoit chaque demande avec toutes les coordonnées.
MAIL_DESTINATAIRE=
